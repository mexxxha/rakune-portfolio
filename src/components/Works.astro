---
import { Image } from 'astro:assets';
import { site } from '../data/site';
---

<section class="works" id="works">
  <h2 class="works__title">イラスト</h2>
  <ul class="works__list">
    {
      site.illustration.map((item) => (
        <li class="works__item">
          <Image class="works__img" src={item.image} alt={item.alt} />
          <p class="works__name">{item.title}</p>
        </li>
      ))
    }
  </ul>
</section>

<style lang="scss">
  .works {
    margin: 30px 0 0;

    &__title {
      margin: 0 0 16px;
      font-size: 24px;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
    }

    &__item {
      min-width: 0;
      min-height: 0;
      padding: 8px;
      background: #c0c0c0;
      border: 2px solid;
      border-radius: 4px;
      border-color: #dfdfdf #0a0a0a #0a0a0a #dfdfdf;
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 2px;
    }

    &__name {
      margin: 8px 0 0;
      text-align: center;
    }
  }
</style>
