---
import { Image } from 'astro:assets';
import { site } from '../data/site';
---

<section class="works" id="works">
  <h2 class="works__title">イラスト</h2>
  <ul class="works__list">
    {
      site.illustration.map((item) => (
        <li class="works__item">
          <button class="works__card" type="button" data-illustration={item.id} data-src={item.image.src} data-title={item.title} data-alt={item.alt}>
            <Image class="works__img" src={item.image} alt="" width={320} height={320} loading="eager" />
            <span class="works__name">{item.title}</span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style lang="scss">
  @use '../globalStyles' as *;

  .works {
    margin: 30px 0 0;

    &__title {
      margin: 0 0 16px;
      font-size: 24px;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
    }

    &__item {
      min-width: 0;
      min-height: 0;
      padding: 8px;
      @include bevel-raised;
    }

    &__card {
      display: block;
      width: 100%;
      color: inherit;
      text-align: center;
    }

    &__img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 2px;
    }

    &__name {
      margin: 8px 0 0;
      text-align: center;
    }
  }
</style>
