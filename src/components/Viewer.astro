---

<div class="viewer" id="viewer" hidden>
  <div class="viewer__bar">
    <p class="viewer__title"></p>
    <button class="viewer__close" type="button" aria-label="閉じる"></button>
  </div>
  <div class="viewer__body">
    <img class="viewer__img" alt="" />
  </div>
</div>

<style lang="scss">
  @use '../globalStyles' as *;

  .viewer {
    position: absolute;
    z-index: 5;
    top: 48px;
    left: max(24px, calc((100% - 720px) / 2));
    width: min(720px, calc(100% - 48px));
    height: calc(100% - 158px);
    display: flex;
    flex-direction: column;
    background: $c-chrome;
    @include bevel-raised(8px);

    &[hidden] {
      display: none;
    }

    &__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 3px 3px 0;
      padding: 3px;
      border-radius: 2px;
      background-color: #000080;
      color: #fff;
      cursor: grab;
      touch-action: none;
      user-select: none;

      &:active {
        cursor: grabbing;
      }
    }

    &__title {
      margin: 0;
      padding-inline: 8px;
    }

    &__close {
      position: relative;
      width: 22px;
      height: 20px;
      background: $c-chrome;
      @include bevel-raised(2px);

      &::before,
      &::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 4px;
        left: 4px;
        height: 1px;
        background: #000;
      }

      &::before {
        rotate: 45deg;
      }

      &::after {
        rotate: -45deg;
      }
    }

    &__body {
      flex: 1;
      min-height: 0;
      padding: 12px;
    }

    &__img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }
</style>

<script src="../scripts/viewer.ts"></script>
<script src="../scripts/viewerDrag.ts"></script>
