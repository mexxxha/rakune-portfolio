<div class="boot" id="boot" aria-hidden="true">
  <div class="boot__window">
    <p class="boot__title">COMMAND PROMPT</p>
    <div class="boot__screen">
      <div class="boot__log" id="boot-log"></div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../globalStyles' as *;

  .boot {
    position: fixed;
    z-index: 10;
    inset: 0;
    display: grid;
    place-items: center;
    background: $c-background-base;

    &__window {
      width: min(440px, calc(100% - 32px));
      @include bevel-raised(8px);
    }

    &__title {
      margin: 3px 3px 0;
      padding: 4px 8px;
      border-radius: 2px;
      background-color: #000080;
      color: #fff;
      line-height: 1.4;
    }

    &__screen {
      margin: 8px;
      padding: 8px;
      background: #000;
      color: $c-chrome;
    }

    &__log {
      height: 160px;
      overflow: hidden;
      font-size: 16px;
      line-height: 20px;
    }

    &__line {
      height: 20px;
      margin: 0;
      white-space: pre;
    }

    &__cursor {
      display: inline-block;
      width: 1ch;
      height: 1em;
      background: currentColor;
      vertical-align: text-bottom;
      animation: boot-blink 530ms step-end infinite;
    }
  }

  @keyframes boot-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot__cursor {
      animation: none;
    }
  }
</style>

<script src="../scripts/boot.ts"></script>