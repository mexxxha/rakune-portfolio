---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
---

<div class="wrap">
  <nav class="dock" aria-label="ドック">
    <ul class="dock__list">
      {
        site.illustration.map((item) => (
          <li>
            <button class="dock__icon" type="button" aria-label={item.title} data-illustration={item.id} data-src={item.image.src} data-title={item.title} data-alt={item.alt}>
              <Image src={item.image} alt="" width={100} height={100} />
            </button>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="dock__start">
    <nav class="dock__popup" id="dock-popup" aria-label="メニュー">
      <p class="dock__popup_brand">{site.title}</p>
      <ul class="dock__popup_list">
        {
          site.nav.map((item) => (
            <li>
              <a class="dock__popup_link" href={`#${item.id}`}>
                <Icon class="dock__popup_thumb" name={item.icon} aria-hidden="true" />
                <span class="dock__popup_label">{item.kana}</span>
              </a>
            </li>
          ))
        }
        {
          site.social.map((item) => (
            <li>
              <a class="dock__popup_link" href={item.href} target="_blank">
                <Icon class="dock__popup_thumb" name={item.icon} aria-hidden="true" />
                <span class="dock__popup_label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="dock__menu" type="button" aria-expanded="false" aria-controls="dock-popup" aria-label="メニュー">
      <span class="dock__menu_icon" aria-hidden="true"></span>
      <span class="dock__menu_icon" aria-hidden="true"></span>
    </button>
  </div>
</div>

<style lang="scss">
  @use '../globalStyles' as *;

  .wrap {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    z-index: 4;

    @include tablet {
      display: flex;
      align-items: flex-end;
      gap: 12px;
    }
  }

  .dock {
    height: 72px;
    padding: 0 0 8px;
    @include bevel-raised;

    @include tablet {
      max-width: calc(5 * 50px + 4 * 8px + 16px + 4px);
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    &__list {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      height: 100%;
      padding-inline: 8px;

      @include tablet {
        width: max-content;
      }

      li:nth-child(n + 11) {
        @media (min-width: ($tablet + 1px)) {
          display: none;
        }
      }
    }

    &__icon {
      display: grid;
      place-items: center;
      width: 50px;
      height: 50px;
      overflow: hidden;
      border-radius: 2px;
      background: #c0c0c0;
      transform-origin: center bottom;
      transition: transform 150ms ease-out;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__start {
      display: none;
      position: absolute;
      top: 0;
      left: calc(100% + 12px);
      height: 100%;
      aspect-ratio: 1;

      @include tablet {
        display: block;
        position: relative;
        top: auto;
        left: auto;
        height: 72px;
        flex-shrink: 0;
      }
    }

    &__start:has(&__menu[aria-expanded='true']) &__popup {
      display: flex;
    }

    &__popup {
      display: none;
      position: absolute;
      right: 0;
      bottom: calc(100% + 6px);
      min-width: 280px;
      padding: 2px;
      border-radius: 8px;
      background: #c0c0c0;
      @include bevel-inset;

      &_brand {
        font-family: $pokemon;
        display: grid;
        place-items: center;
        width: 36px;
        border-radius: 6px 0 0 6px;
        background: #3a3335;
        color: #fff;
        writing-mode: vertical-rl;
        letter-spacing: 0.15em;
      }

      &_list {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 2px;
      }

      &_link {
        font-family: $pokemon;
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 48px;
        padding: 8px 16px 8px 10px;
        color: #000;
        line-height: 1;

        &:hover,
        &:focus-visible {
          background: #000080;
          color: #fff;
          outline: none;
        }
      }

      &_thumb {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        object-fit: cover;
        fill: currentColor;
      }
    }

    &__menu {
      width: 100%;
      height: 100%;
      @include bevel-raised;
      transition:
        scale 226ms ease,
        background-color 226ms ease,
        box-shadow 226ms ease;

      &:active {
        scale: 0.92;
      }

      &[aria-expanded='true'] {
        border-color: $c-bevel-dark $c-bevel-light $c-bevel-light $c-bevel-dark;
      }

      &_icon {
        position: absolute;
        top: 50%;
        left: 14px;
        right: 14px;
        height: 2px;
        background: #3a3335;
        transition:
          translate 200ms ease,
          rotate 200ms ease;

        &:first-child {
          translate: 0 calc(-50% - 3.5px);
        }

        &:last-child {
          translate: 0 calc(-50% + 3.5px);
        }
      }

      &[aria-expanded='true'] &_icon {
        &:first-child {
          translate: 0 -50%;
          rotate: 45deg;
        }

        &:last-child {
          translate: 0 -50%;
          rotate: -45deg;
        }
      }
    }
  }
</style>

<script src="../scripts/dock.ts"></script>
<script src="../scripts/dockMenu.ts"></script>
