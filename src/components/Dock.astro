---
import { Image } from 'astro:assets';
import { site } from '../data/site';
---

<div class="wrap">
  <nav class="dock" aria-label="ドック">
    <ul class="dock__list">
      <li>
        <a class="dock__icon" href="#profile" aria-label="プロフィール">
          <Image src={site.profile.profileImg} alt="" />
        </a>
      </li>
      <li>
        <a class="dock__icon" href="#works" aria-label="イラスト">
          <Image src={site.illustration[0].image} alt="" />
        </a>
      </li>
    </ul>
  </nav>
  <div class="dock__start">
    <nav class="dock__popup" id="dock-popup" aria-label="メニュー">
      <p class="dock__popup_brand">{site.title}</p>
      <ul class="dock__popup_list">
        <li>
          <a class="dock__popup_link" href="#profile">
            <Image class="dock__popup_thumb" src={site.profile.profileImg} alt="" />
            <span class="dock__popup_label">ぷろふぃーる</span>
          </a>
        </li>
        <li>
          <a class="dock__popup_link" href="#works">
            <Image class="dock__popup_thumb" src={site.illustration[0].image} alt="" />
            <span class="dock__popup_label">いらすと</span>
          </a>
        </li>
        <li>
          <a class="dock__popup_link" href="#contact">
            <span class="dock__popup_thumb" aria-hidden="true"></span>
            <span class="dock__popup_label">おといあわせ</span>
          </a>
        </li>
        <li>
          <a class="dock__popup_link" href="#" target="_blank">
            <span class="dock__popup_thumb" aria-hidden="true"></span>
            <span class="dock__popup_label">いんすたぐらむ</span>
          </a>
        </li>
        <li>
          <a class="dock__popup_link" href="#" target="_blank">
            <span class="dock__popup_thumb" aria-hidden="true"></span>
            <span class="dock__popup_label">ついったー</span>
          </a>
        </li>
        <li>
          <a class="dock__popup_link" href="#" target="_blank">
            <span class="dock__popup_thumb" aria-hidden="true"></span>
            <span class="dock__popup_label">ゆーちゅーぶ</span>
          </a>
        </li>
      </ul>
    </nav>
    <button class="dock__menu" type="button" aria-expanded="false" aria-controls="dock-popup" aria-label="メニュー">
      <span class="dock__menu_icon" aria-hidden="true"></span>
      <span class="dock__menu_icon" aria-hidden="true"></span>
    </button>
  </div>
</div>

<style lang="scss">
  @use '../globalStyles' as *;

  .wrap {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    z-index: 4;
  }

  .dock {
    height: 72px;
    padding: 0 8px 8px;
    @include bevel-raised;

    &__list {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      height: 100%;
    }

    &__icon {
      display: grid;
      place-items: center;
      width: 50px;
      height: 50px;
      overflow: hidden;
      border-radius: 2px;
      background: #c0c0c0;
      transform-origin: center bottom;
      transition: transform 150ms ease-out;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__start {
      display: none;
      position: absolute;
      top: 0;
      left: calc(100% + 12px);
      height: 100%;
      aspect-ratio: 1;

      @include tablet {
        display: block;
      }
    }

    &__start:has(&__menu[aria-expanded='true']) &__popup {
      display: flex;
    }

    &__popup {
      display: none;
      position: absolute;
      right: 0;
      bottom: calc(100% + 6px);
      min-width: 280px;
      padding: 2px;
      border-radius: 8px;
      background: #c0c0c0;
      @include bevel-inset;

      &_brand {
        font-family: $pokemon;
        display: grid;
        place-items: center;
        width: 36px;
        border-radius: 6px 0 0 6px;
        background: #3a3335;
        color: #fff;
        writing-mode: vertical-rl;
        letter-spacing: 0.15em;
      }

      &_list {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 2px;
      }

      &_link {
        font-family: $pokemon;
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 48px;
        padding: 8px 16px 8px 10px;
        color: #000;
        line-height: 1;

        &:hover,
        &:focus-visible {
          background: #000080;
          color: #fff;
          outline: none;
        }
      }

      &_thumb {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        object-fit: cover;
      }
    }

    &__menu {
      width: 100%;
      height: 100%;
      @include bevel-raised;
      transition:
        scale 226ms ease,
        background-color 226ms ease,
        box-shadow 226ms ease;

      &:active {
        scale: 0.92;
      }

      &[aria-expanded='true'] {
        border-color: $c-bevel-dark $c-bevel-light $c-bevel-light $c-bevel-dark;
      }

      &_icon {
        position: absolute;
        top: 50%;
        left: 14px;
        right: 14px;
        height: 2px;
        background: #3a3335;
        transition:
          translate 200ms ease,
          rotate 200ms ease;

        &:first-child {
          translate: 0 calc(-50% - 3.5px);
        }

        &:last-child {
          translate: 0 calc(-50% + 3.5px);
        }
      }

      &[aria-expanded='true'] &_icon {
        &:first-child {
          translate: 0 -50%;
          rotate: 45deg;
        }

        &:last-child {
          translate: 0 -50%;
          rotate: -45deg;
        }
      }
    }
  }
</style>

<script src="../scripts/dock.ts"></script>
<script src="../scripts/dockMenu.ts"></script>
