---
import { site } from '../data/site';
import '../globalStyles/reset.css';
import '../globalStyles/global.scss';

import Dock from '../components/Dock.astro';
import Sidebar from '../components/Sidebar.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{site.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <header class="header">
        <div class="header__buttons">
          <span class="header__buttons_red" aria-hidden="true"></span>
          <span class="header__buttons_yellow" aria-hidden="true"></span>
          <span class="header__buttons_green" aria-hidden="true"></span>
        </div>
      </header>
      <main class="main">
        <Sidebar />
        <div class="main__content"></div>
      </main>
      <Dock />
    </div>
  </body>
</html>

<style lang="scss">
  @use '../globalStyles' as *;

  .container {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    border: 3px solid transparent;
    border-radius: 20px;
    background:
      linear-gradient(#9e9e9e, #9e9e9e) padding-box,
      linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.35) 28%, rgba(255, 255, 255, 0.08) 55%, rgba(255, 255, 255, 0.55) 100%) border-box;
    overflow: hidden;
  }

  .header {
    padding: 10px 15px;
    border-bottom: 3px solid rgba(255, 255, 255, 0.45);
    background-color: #c7c6c6;

    &__buttons {
      display: flex;
      gap: 12px;

      &_red {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        background-color: red;
      }
      &_yellow {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        background-color: yellow;
      }
      &_green {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        background-color: green;
      }
    }
  }

  .main {
    --sidebar-width: 200px;
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;

    &__content {
      position: relative;
      z-index: 0;
      flex: 1;
      min-width: 0;
      min-height: 0;
      margin-left: var(--sidebar-width);
      padding: 10px 15px;
      overflow-y: auto;
      transition: margin-left 320ms ease 130ms;

      @include tablet {
        margin-left: 0;
      }
    }

    &.is-closing &__content {
      transition: none;
      animation: content-close 450ms ease forwards;
    }

    &.is-opening &__content {
      transition: none;
      animation: content-open 450ms ease forwards;
    }

    &.is-sidebar-collapsed &__content {
      margin-left: 0;
    }
  }

  @keyframes content-close {
    0% {
      margin-left: var(--sidebar-width);
    }
    30% {
      margin-left: calc(var(--sidebar-width) + 14px);
    }
    100% {
      margin-left: 0;
    }
  }

  @keyframes content-open {
    0% {
      margin-left: 0;
    }
    70% {
      margin-left: calc(var(--sidebar-width) + 14px);
    }
    100% {
      margin-left: var(--sidebar-width);
    }
  }
</style>