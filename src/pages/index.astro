---
import { site } from '../data/site';
import '../globalStyles/reset.css';
import '../globalStyles/global.scss';

import Dock from '../components/Dock.astro';
import Sidebar from '../components/Sidebar.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{site.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <header class="header">
        <div class="header__buttons">
          <span class="header__buttons_minimize" aria-hidden="true"></span>
          <span class="header__buttons_maximize" aria-hidden="true"></span>
          <span class="header__buttons_close" aria-hidden="true"></span>
        </div>
      </header>
      <main class="main">
        <Sidebar />
        <div class="main__content"></div>
      </main>
      <Dock />
    </div>
  </body>
</html>

<style lang="scss">
  @use '../globalStyles' as *;

  .container {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    border: 2px solid;
    border-radius: 8px;
    border-color: #dfdfdf #0a0a0a #0a0a0a #dfdfdf;
    background: #c0c0c0;
    overflow: hidden;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin: 3px 3px 0;
    padding: 2px 3px;
    border-bottom: 2px solid #0a0a0a;
    box-shadow: inset 0 1px #dfdfdf;
    background-color: #000080;

    &__buttons {
      display: flex;
      gap: 7px;

      span {
        position: relative;
        width: 22px;
        height: 20px;
        background: #c0c0c0;
        border: 1px solid;
        border-radius: 2px;
        border-color: #fff #0a0a0a #0a0a0a #fff;
        box-shadow: inset 1px 1px #dfdfdf;
      }

      &_minimize::before {
        content: '';
        position: absolute;
        right: 3px;
        bottom: 3px;
        left: 3px;
        height: 2px;
        background: #000;
      }
      &_maximize::before {
        content: '';
        position: absolute;
        inset: 3px;
        border: 1px solid #000;
        border-top-width: 2px;
      }
      &_close::before,
      &_close::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 3px;
        left: 3px;
        height: 1px;
        background: #000;
      }
      &_close::before {
        rotate: 45deg;
      }
      &_close::after {
        rotate: -45deg;
      }
    }
  }

  .main {
    --sidebar-width: 200px;
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;

    &__content {
      position: relative;
      z-index: 0;
      flex: 1;
      min-width: 0;
      min-height: 0;
      margin-left: var(--sidebar-width);
      padding: 10px 15px;
      overflow-y: auto;
      transition: margin-left 320ms ease 130ms;

      @include tablet {
        margin-left: 0;
      }
    }

    &.is-closing &__content {
      transition: none;
      animation: content-close 450ms ease forwards;
    }

    &.is-opening &__content {
      transition: none;
      animation: content-open 450ms ease forwards;
    }

    &.is-sidebar-collapsed &__content {
      margin-left: 0;
    }
  }

  @keyframes content-close {
    0% {
      margin-left: var(--sidebar-width);
    }
    30% {
      margin-left: calc(var(--sidebar-width) + 14px);
    }
    100% {
      margin-left: 0;
    }
  }

  @keyframes content-open {
    0% {
      margin-left: 0;
    }
    70% {
      margin-left: calc(var(--sidebar-width) + 14px);
    }
    100% {
      margin-left: var(--sidebar-width);
    }
  }
</style>
