---
import { site } from '../data/site';
import '../globalStyles/reset.css';
import '../globalStyles/global.scss';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{site.title}</title>
  </head>
  <body>
    <div class="container">
      <header class="header">
        <div class="header__buttons">
          <button class="header__buttons_red"></button>
          <button class="header__buttons_yellow"></button>
          <button class="header__buttons_green"></button>
        </div>
      </header>
      <main class="main">
        <aside>
					<a href="/">
						<h1>らくね</h1>
					</a>
				</aside>
      </main>
    </div>
  </body>
</html>

<style lang="scss">
  @use '../globalStyles' as *;

  .container {
    width: 100%;
    height: 100%;
    border: 3px solid transparent;
    border-radius: 20px;
    background:
      linear-gradient(#9e9e9e, #9e9e9e) padding-box,
      linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.35) 28%, rgba(255, 255, 255, 0.08) 55%, rgba(255, 255, 255, 0.55) 100%) border-box;
    overflow: hidden;
  }

  .header {
    padding: 10px 15px;
    border-bottom: 3px solid rgba(255, 255, 255, 0.45);
    background-color: #c7c6c6;

    &__buttons {
      display: flex;
      gap: 12px;

      &_red {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        background-color: red;
      }
      &_yellow {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        background-color: yellow;
      }
      &_green {
        width: 15px;
        height: 15px;
        border-radius: 999px;
        background-color: green;
      }
    }
  }

  .main {
    padding: 10px 15px;
  }
</style>
